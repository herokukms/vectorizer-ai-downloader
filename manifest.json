{
  "manifest_version": 3,
  "name": "Vectorizer.AI Downloader",
  "version": "0.1.0",
  "description": "Reads the vector result straight from vectorizer.ai's in-page model and downloads it as a full SVG.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://vectorizer.ai/*"],
      "js": ["content.js"],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ]
}